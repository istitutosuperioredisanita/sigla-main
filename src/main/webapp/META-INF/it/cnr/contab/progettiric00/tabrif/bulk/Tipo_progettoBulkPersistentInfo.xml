<SQLPersistentInfo
	persistentClassName="it.cnr.contab.progettiric00.tabrif.bulk.Tipo_progettoBulk"
	homeClassName="it.cnr.contab.progettiric00.tabrif.bulk.Tipo_progettoHome">
	<defaultColumnMap
		tableName="TIPO_PROGETTO">
	</defaultColumnMap>

	<columnMap name="FONDI_FUNZIONAMENTO"
			   tableName="TIPO_PROGETTO">
		<columnMapping
				columnName="CD_TIPO_PROGETTO"
				propertyName="cd_tipo_progetto"
				sqlTypeName="VARCHAR"
				columnSize="10"
				nullable="false"
				primary="true" />
		<columnMapping
				columnName="DS_TIPO_PROGETTO"
				propertyName="ds_tipo_progetto"
				sqlTypeName="VARCHAR"
				columnSize="100"
				nullable="false" />
		<columnMapping
				columnName="SUM(NVL(V_SALDI_PIANO_ECONOM_PROGETTO.IMPORTO_FIN,0) + NVL(V_SALDI_PIANO_ECONOM_PROGETTO.IMPORTO_COFIN,0)) IMPORTO_FINANZIATO"
				propertyName="importoFinanziato"
				columnSize="17"
				columnScale="2"
				count="true"/>
		<columnMapping
				columnName="SUM(NVL(V_SALDI_PIANO_ECONOM_PROGETTO.IMPACC_FIN,0) + (NVL(V_SALDI_PIANO_ECONOM_PROGETTO.TRASFPIU_FIN,0) - NVL(V_SALDI_PIANO_ECONOM_PROGETTO.TRASFMENO_FIN,0))) IMPORTO_UTILIZZATO"
				propertyName="importoUtilizzato"
				columnSize="17"
				columnScale="2"
				count="true"/>
	</columnMap>
	<persistentProperty
			name="importoFinanziato" />
	<persistentProperty
			name="importoUtilizzato" />

</SQLPersistentInfo>
