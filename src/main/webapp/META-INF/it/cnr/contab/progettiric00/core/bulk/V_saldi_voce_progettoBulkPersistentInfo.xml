<SQLPersistentInfo
	persistentClassName="it.cnr.contab.progettiric00.core.bulk.V_saldi_voce_progettoBulk"
	homeClassName="it.cnr.contab.progettiric00.core.bulk.V_saldi_voce_progettoHome">

	<defaultColumnMap
			tableName="V_SALDI_VOCE_PROGETTO" >
		<columnMapping
				columnName="ESERCIZIO_VOCE"
				propertyName="elemento_voce.esercizio"
				fetchOnly="false" />
		<columnMapping
				columnName="TI_APPARTENENZA"
				propertyName="elemento_voce.ti_appartenenza"
				fetchOnly="false" />
		<columnMapping
				columnName="TI_GESTIONE"
				propertyName="elemento_voce.ti_gestione"
				fetchOnly="false" />
		<columnMapping
				columnName="CD_ELEMENTO_VOCE"
				propertyName="elemento_voce.cd_elemento_voce"
				fetchOnly="false" />
	</defaultColumnMap>

	<persistentProperty
			name="elemento_voce"
			partOfOid= "true"/>

	<fetchPolicy
			name="fetchElementoVoce">
		<exclude pattern="*" />
		<include pattern="elemento_voce" />
	</fetchPolicy>

</SQLPersistentInfo>
