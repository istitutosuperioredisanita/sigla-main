<SQLPersistentInfo
	persistentClassName="it.cnr.contab.anagraf00.core.bulk.TerzoBase"
	homeClassName="it.cnr.contab.anagraf00.core.bulk.TerzoHome" >
	<defaultColumnMap
		tableName="TERZO" >

		<columnMapping
			columnName="CD_ANAG"
			propertyName="anagrafico.cd_anag" />
	 <!--  	<columnMapping
			columnName="CODICE_FISCALE_ANAGRAFICO"
			propertyName="anagrafico.codice_fiscale" />
		<columnMapping
			columnName="PARTITA_IVA_ANAGRAFICO"
			propertyName="anagrafico.partita_iva" />  -->
		<columnMapping
			columnName="PG_COMUNE_SEDE"
			propertyName="comune_sede.pg_comune" />

		<columnMapping
			columnName="PG_RAPP_LEGALE"
			propertyName="rappresentante_legale.pg_rapp_legale" />

		<columnMapping
			columnName="CD_UNITA_ORGANIZZATIVA"
			propertyName="unita_organizzativa.cd_unita_organizzativa" />

	</defaultColumnMap>
	
	<columnMap
		name="V_TERZO_CF_PI"
		tableName="V_TERZO_CF_PI"
		extends="default" >
		<columnMapping
			columnName="CODICE_FISCALE_ANAGRAFICO"
			propertyName="anagrafico.codice_fiscale"
			sqlTypeName="VARCHAR"
			columnSize="20"
			nullable="true" />
		<columnMapping
			columnName="PARTITA_IVA_ANAGRAFICO"
			propertyName="anagrafico.partita_iva"
			sqlTypeName="VARCHAR"
			columnSize="20"
			nullable="true" />
		<columnMapping
			columnName="COGNOME_ANAGRAFICO"
			propertyName="anagrafico.cognome"
			sqlTypeName="VARCHAR"
			columnSize="50"
			nullable="true" />
		<columnMapping
			columnName="NOME_ANAGRAFICO"
			propertyName="anagrafico.nome"
			sqlTypeName="VARCHAR"
			columnSize="50"
			nullable="true" />
	</columnMap>

	<columnMap name="FONDI_FUNZIONAMENTO"
			   tableName="TERZO">
		<columnMapping
				columnName="NVL(TERZO.CD_TERZO, 1) CD_TERZO"
				propertyName="cd_terzo"/>
		<columnMapping
			columnName="DENOMINAZIONE_SEDE"
			propertyName="denominazione_sede"
			sqlTypeName="VARCHAR"
			columnSize="200"
			nullable="false" />

		<columnMapping
				columnName="CD_ANAG"
				propertyName="anagrafico.cd_anag" />
		<columnMapping
				columnName="PG_COMUNE_SEDE"
				propertyName="comune_sede.pg_comune" />
		<columnMapping
				columnName="PG_RAPP_LEGALE"
				propertyName="rappresentante_legale.pg_rapp_legale" />
		<columnMapping
				columnName="CD_UNITA_ORGANIZZATIVA"
				propertyName="unita_organizzativa.cd_unita_organizzativa" />

		<columnMapping
				columnName="SUM(NVL(V_SALDI_PIANO_ECONOM_PROGETTO.IMPORTO_FIN,0) + NVL(V_SALDI_PIANO_ECONOM_PROGETTO.IMPORTO_COFIN,0)) IMPORTO_FINANZIATO"
				propertyName="importoFinanziato"
				columnSize="17"
				columnScale="2"
				count="true"/>
		<columnMapping
				columnName="SUM(NVL(V_SALDI_PIANO_ECONOM_PROGETTO.IMPACC_FIN,0) + (NVL(V_SALDI_PIANO_ECONOM_PROGETTO.TRASFPIU_FIN,0) - NVL(V_SALDI_PIANO_ECONOM_PROGETTO.TRASFMENO_FIN,0))) IMPORTO_UTILIZZATO"
				propertyName="importoUtilizzato"
				columnSize="17"
				columnScale="2"
				count="true"/>
	</columnMap>
	<persistentProperty
			name="importoFinanziato" />
	<persistentProperty
			name="importoUtilizzato" />

	<persistentProperty
		name="anagrafico" />
	<persistentProperty
		name="comune_sede" />
	<persistentProperty
		name="rappresentante_legale" />
	<persistentProperty
		name="unita_organizzativa" />
	<!-- <persistentProperty
		name="anagrafico.codice_fiscale" />
	<persistentProperty
		name="anagrafico.partita_iva" />  -->
	<fetchPolicy
		name="it.cnr.contab.doccont00.comp.ObbligazioneComponent.find.creditore">
		<exclude pattern="*" />
		<include pattern="anagrafico"/>
		<include pattern="comune_sede"/>
		<exclude pattern="anagrafico.*"/>		
	</fetchPolicy>

</SQLPersistentInfo>
