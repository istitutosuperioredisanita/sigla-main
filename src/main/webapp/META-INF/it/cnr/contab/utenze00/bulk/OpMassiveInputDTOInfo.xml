<bulkInfo
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns="https://contab.cnr.it/schema/SIGLA"
		xsi:schemaLocation="https://contab.cnr.it/schema/SIGLA https://contab.cnr.it/schema/SIGLA/BulkInfo_1_5.xsd"
		shortDescription="Gestione massiva utenze"
		longDescription="Gestione massiva utenze">

	<fieldProperty
			name="tipoOperazione"
			property="tipoOperazione"
			inputType="RADIOGROUP"
			layout="HORIZONTAL"
			keysProperty="tipoOperazioneKeys"
			enabledOnSearch="true"
			enabledOnInsert="true"
			enabledOnEdit="true"
			enabledOnFreeSearch="true"
			label="Tipo operazione" />

	<fieldProperty
			name="nota"
			property="nota"
			inputType="TEXTAREA"
			cols="100"
			rows="4"
			readonlyProperty="RONota"
			inputCssClass="alert alert-info w-100"
			label="Nota" />

	<formFieldProperty name="tipoOperazione" />
	<formFieldProperty name="nota" />

</bulkInfo>
